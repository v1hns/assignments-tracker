{
  "name": "assignments-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create assignments",
    "db:init": "wrangler d1 execute assignments --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute assignments --local --file=./schema.sql",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.95.0"
  }
}
